{
  "name": "mahastride-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:production-api": "npm run dev:production-api --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=backend",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "test:a11y": "npm run test:a11y --workspace=frontend",
    "test:i18n": "npm run test:i18n --workspace=frontend"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^8.2.0"
  }
}
