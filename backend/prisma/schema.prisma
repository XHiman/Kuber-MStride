generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Bill {
  id        String    @id @default(cuid())
  sr        Int?
  vendor    String
  invoice   String
  date      DateTime?
  amount    Float
  budgetCode String?
  objectHead String?
  transferId String?
  budgetHead BudgetHead? @relation(fields: [budgetCode], references: [code])
  objectHeadRef ObjectHead? @relation("BillObjectHead", fields: [objectHead], references: [code])
  transfer Transfer? @relation(fields: [transferId], references: [id])
  bucket    String
  cat       String
  status    String
  attribute String?
  note      String?
  days      Int?
  clearedFY String?
  source    String    @default("seed")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("bills")
}

model Budget {
  id         String     @id
  code       String     @unique
  objectHead ObjectHead @relation(fields: [code], references: [code])
  name       String
  nameMr     String
  prov215    Float      @default(0)
  exp215     Float      @default(0)
  prov224    Float      @default(0)
  exp224     Float      @default(0)
  prov233    Float      @default(0)
  exp233     Float      @default(0)

  @@map("budgets")
}

model BudgetHead {
  code        String @id
  name        String
  description String
  bills       Bill[]

  @@map("budget_heads")
}

model ObjectHead {
  code    String   @id
  name    String
  nameMr  String
  budgets Budget[]
  bills   Bill[] @relation("BillObjectHead")

  @@map("object_heads")
}

model Transfer {
  id         String    @id @default(cuid())
  recipient  String
  purpose    String
  objectCode String
  amount     Float
  orderDate  DateTime?
  status     String
  utilized   Float     @default(0)
  remarks    String?
  source     String    @default("seed")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bills      Bill[]

  @@map("transfers")
}

model District {
  id          String    @id @default(cuid())
  district    String
  division    String
  amount      Float     @default(0)
  releaseDate DateTime?
  remarks     String?
  source      String    @default("seed")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("districts")
}