generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Bill {
  id        String    @id @default(cuid())
  sr        Int?
  vendor    String
  invoice   String
  date      DateTime?
  amount    Float
  budgetCode String?
  objectHead String?
  transferId String?
  program    String?
  district   String?
  assignedUserId String?
  budgetHead BudgetHead? @relation(fields: [budgetCode], references: [code])
  objectHeadRef ObjectHead? @relation("BillObjectHead", fields: [objectHead], references: [code])
  transfer Transfer? @relation(fields: [transferId], references: [id])
  assignedUser User? @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  bucket    String
  cat       String
  status    String
  attribute String?
  note      String?
  days      Int?
  clearedFY String?
  source    String    @default("seed")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("bills")
}

model Budget {
  id         String     @id
  code       String
  fiscalYear String     @default("FY 2026-27")
  objectHead ObjectHead @relation(fields: [code], references: [code])
  name       String
  nameMr     String
  prov215    Float      @default(0)
  exp215     Float      @default(0)
  prov224    Float      @default(0)
  exp224     Float      @default(0)
  prov233    Float      @default(0)
  exp233     Float      @default(0)

  @@unique([fiscalYear, code])
  @@map("budgets")
}

model BudgetHead {
  code        String @id
  name        String
  description String
  bills       Bill[]
  transfers   Transfer[]

  @@map("budget_heads")
}

model ObjectHead {
  code    String   @id
  name    String
  nameMr  String
  budgets Budget[]
  bills   Bill[] @relation("BillObjectHead")

  @@map("object_heads")
}

model Transfer {
  id         String    @id @default(cuid())
  recipient  String
  scopeType  String?
  purpose    String
  objectCode String
  amount     Float
  fiscalYear String    @default("FY 2026-27")
  budgetCode String?
  budgetHead BudgetHead? @relation(fields: [budgetCode], references: [code])
  orderDate  DateTime?
  status     String
  utilized   Float     @default(0)
  remarks    String?
  source     String    @default("seed")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bills      Bill[]
  history    TransferHistory[]

  @@map("transfers")
}

model User {
  id           String   @id @default(cuid())
  username     String?  @unique
  passwordHash String?
  name         String
  programs     String   @default("[]")
  districts    String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bills        Bill[]

  @@map("users")
}

model TransferHistory {
  id          String   @id @default(cuid())
  transferId  String
  changedAt   DateTime @default(now())
  field       String
  oldValue    String?
  newValue    String?
  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId, changedAt])
  @@map("transfer_history")
}

model District {
  id          String    @id @default(cuid())
  district    String
  division    String
  amount      Float     @default(0)
  releaseDate DateTime?
  remarks     String?
  source      String    @default("seed")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("districts")
}
